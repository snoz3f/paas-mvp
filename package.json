{
  "name": "paas-mvp",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "argon2",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "api": "pnpm --filter api start:dev",
    "web": "pnpm --filter web dev",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "generate": "pnpm --filter web orval"
  }
}
