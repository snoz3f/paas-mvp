generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  passwordHash      String
  githubAccessToken String?
  githubLogin       String?
  createdAt         DateTime @default(now())

  projects Project[]
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  apps     App[]
  services Service[]
}

model App {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  name          String
  repoUrl       String
  rootDir       String   @default(".")
  domain        String?  @unique
  framework     String?
  port          Int      @default(3000)
  envVars       Json     @default("{}")
  gitToken      String?
  webhookSecret String?
  createdAt     DateTime @default(now())

  ramMb    Int @default(512)
  cpuMilli Int @default(500)
  diskGb   Int @default(5)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments Deployment[]
}

model Service {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @db.Uuid
  nodeId      String?       @db.Uuid
  type        ServiceType
  status      ServiceStatus @default(PROVISIONING)
  containerId String?
  version     String        @default("latest")
  envKey           String
  connectionString String?
  createdAt        DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum ServiceType {
  POSTGRES
  REDIS
}

enum ServiceStatus {
  PROVISIONING
  RUNNING
  FAILED
  STOPPED
}

model Deployment {
  id          String           @id @default(uuid()) @db.Uuid
  appId       String           @db.Uuid
  status      DeploymentStatus @default(QUEUED)
  nodeId      String?          @db.Uuid
  containerId String?
  imageTag    String?
  commitHash  String?
  url         String?
  error       String?
  logs        String?
  createdAt   DateTime         @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  app       App        @relation(fields: [appId], references: [id])
  container Container?
}

model Node {
  id               String     @id @default(uuid()) @db.Uuid
  name             String     @unique
  ip               String
  region           String?
  provider         String?
  status           NodeStatus @default(OFFLINE)
  cpuUsage         Float      @default(0)
  ramUsage         Float      @default(0)
  activeContainers Int        @default(0)
  lastHeartbeat    DateTime?
  totalRamMb       Int        @default(0)
  totalDiskGb      Int        @default(0)
  tokenHash        String?
}

model Container {
  id           String   @id @default(uuid()) @db.Uuid
  deploymentId String   @unique @db.Uuid
  containerId  String
  status       String
  port         Int?
  createdAt    DateTime @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id])
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  RUNNING
  FAILED
  STOPPED
}

enum NodeStatus {
  ONLINE
  OFFLINE
}
